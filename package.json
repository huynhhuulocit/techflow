{
  "name": "visual-tech-interview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run lessons:validate",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude tests/interview-translations.test.mjs --exclude tests/sfcc-seed.test.mjs && node --test tests/interview-translations.test.mjs tests/sfcc-seed.test.mjs",
    "test:browser": "node scripts/check-lesson-browser.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "content:import": "node scripts/import-gamestream-interview.mjs",
    "content:check": "node scripts/import-gamestream-interview.mjs --check",
    "content:hash": "node scripts/import-gamestream-interview.mjs --hash",
    "content:validate": "node scripts/validate-interview-content.mjs",
    "lessons:validate": "vitest run src/content/lessons.test.ts",
    "verify:deploy": "npm run lint && npm test && npm run content:check && npm run content:validate && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "openai": "^7.10.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "^29.1.1",
    "typescript-eslint": "latest",
    "vitest": "^5.0.0"
  }
}
